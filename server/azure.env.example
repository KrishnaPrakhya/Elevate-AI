# Azure Container Apps configuration template. Copy values into Container App
# > Environment variables and secrets; do not commit real values.

# Networking
PORT=8080
CORS_ALLOWED_ORIGINS=https://elevate-ai-snowy.vercel.app,http://localhost:3000

# Shared with Vercel. Generate a long random value and use the exact same value
# in the Vercel project and this Container App.
INTERNAL_API_SECRET=replace-with-a-long-random-secret

# Database (the same Neon/Postgres connection used by the web app)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Groq hosted inference
GROQ_API_KEY=replace-with-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# LangGraph search (only if search is enabled in the backend)
TAVILY_API_KEY=

# Google Calendar OAuth. This callback must exactly match the Azure FQDN below
# and the Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=replace-with-a-second-long-random-secret
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-APP.REGION.azurecontainerapps.io/api/google/callback

# Optional integrations used by their respective endpoints
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
